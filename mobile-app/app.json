{
  "expo": {
    "name": "Hooligans Map",
    "slug": "hooligans-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Η εφαρμογή χρειάζεται πρόσβαση στην κάμερα για λήψη φωτογραφιών σημείων.",
        "NSLocationWhenInUseUsageDescription": "Η εφαρμογή χρειάζεται πρόσβαση στην τοποθεσία για την καταγραφή του GPS στίγματος των φωτογραφιών σας."
      }
    },
    "android": {
      "package": "com.lesvosmtb.hooligansmap",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "ACCESS_MEDIA_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "e0834c7d-4935-467c-bcba-240c5d130d2a"
      }
    }
  }
}
